# Copy this file to ".env" and adjust values for local development or EC2.

# Frontend -> backend API base URL
APP_BASE_URL=http://127.0.0.1:8000

# Request timeouts in seconds
REQUEST_TIMEOUT=30
AV_REQUEST_TIMEOUT=180
HISTORY_REQUEST_TIMEOUT=90
MAX_RECORD_SECONDS=30
VIDEO_EMOTION_SAMPLE_EVERY=60
VIDEO_EMOTION_MAX_WIDTH=160
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# FastAPI/uvicorn bind settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Streamlit bind settings
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Optional database override.
# Leave blank to use the bundled SQLite database.
DATABASE_URL=
